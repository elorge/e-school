{
  "name": "eschools-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Elorge Schools API — NestJS + PostgreSQL (Prisma)",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/mapped-types": "^2.0.5",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "class-transformer": "^0.5.1",
    "bcrypt": "^5.1.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "pdfkit": "^0.15.2",
    "mathjax-full": "^3.2.2",
    "svg-to-pdfkit": "^0.1.8",
    "cloudinary": "^2.5.1",
    "multer": "^1.4.5-lts.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "nodemon": "^3.1.4",
    "@types/node": "^20.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.5",
    "@types/pdfkit": "^0.13.4",
    "@types/multer": "^1.4.12",
    "@types/svg-to-pdfkit": "^0.1.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.12"
  }
}