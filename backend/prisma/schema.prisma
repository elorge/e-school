// backend/prisma/schema.prisma
// Eschools — complete data model.
// This file is the single source of truth for the database schema.
// Row-Level Security policies (see spec doc §3, Multi-Tenancy Strategy)
// are NOT expressible in Prisma's schema language — add them as raw SQL
// inside a migration (prisma migrate dev --create-only, then hand-edit
// the generated .sql file) before going to production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform & tenancy ─────────────────────────────────────────────────

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

model School {
  id                          String       @id @default(uuid())
  slug                        String       @unique // path-based tenant id, e.g. "greenwood-college"
  name                        String
  code                        String       @unique // short code used to build Admission IDs, e.g. "GRW"
  logoUrl                     String?
  signatureUrl                String? // head of school's signature image, for report cards
  info                        Json? // address, contact info — rendered onto reports
  countryCode                 String       // ISO 3166-1 alpha-2, e.g. "NG", "GH", "KE" — drives which local payment rails (see DVA_SUPPORTED_COUNTRIES) are offered
  timezone                    String
  currency                    String       // ISO 4217, e.g. "NGN", "GHS", "KES" — see currency.util.ts. Every Kobo-named field below is actually "minor unit of THIS currency".
  locale                      String       @default("en") // ISO 639-1, e.g. "en", "fr" — see locale.util.ts. Defaults from countryCode at creation (localeForCountry), overridable per school. Drives report card labels, CBT UI copy, and system emails sent about this school.
  pricePerStudentKoboOverride Int? // null = use platform default; minor unit of `currency` above, not literally kobo
  sessionWrapEnabled          Boolean      @default(false) // per-school flag — off by default, turned on per pilot school
  status                      SchoolStatus @default(ACTIVE)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  users             User[]
  classes           Class[]
  students          Student[]
  terms             Term[]
  subjects          Subject[]
  subjectCareerFields SubjectCareerField[]
  pins              Pin[]
  lessonNotes       LessonNote[]
  pinLookupAttempts PinLookupAttempt[]
  ledgerEntries     WalletLedgerEntry[]
  reportTemplate    ReportTemplate?
  idCards           IdCard[]
  attendanceRecords AttendanceRecord[]
  calendarEvents    AcademicCalendarEvent[]
  cbtTests          CbtTest[]

  feeStructures     FeeStructure[]
  feeInvoices       FeeInvoice[]
  feePayments       FeePayment[]
  inventoryItems    InventoryItem[]
  inventoryTx       InventoryTransaction[]
  expenseEntries    ExpenseEntry[]
  assessmentWeights AssessmentWeight[]
  assessmentScores  AssessmentScore[]

  staffProfiles         StaffProfile[]
  staffIdCards          StaffIdCard[]
  staffIdCardRequests   StaffIdCardRequest[]
  staffAttendanceRecords StaffAttendanceRecord[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  staffLeaveBalances    StaffLeaveBalance[]

  @@map("schools")
}

enum Role {
  SUPER_ADMIN // Elorge — platform-wide, cross-tenant
  FINANCE_OPS // Elorge — platform-wide, billing only
  SCHOOL_ADMIN // single school
  STAFF // single school, assigned class(es)
}

model User {
  id           String   @id @default(uuid())
  schoolId     String? // null for SUPER_ADMIN / FINANCE_OPS
  school       School?  @relation(fields: [schoolId], references: [id])
  role               Role
  email              String   @unique
  passwordHash       String
  fullName           String
  mustChangePassword Boolean  @default(false) // true when an admin sets the password directly (not the invite-link flow) — forces a change on first login
  createdAt          DateTime @default(now())
  lessonNotesCreated    LessonNote[]         @relation("LessonNoteCreatedBy")
  classesCreated        Class[]              @relation("ClassCreatedBy")
  classesTeaching       Class[]              @relation("ClassTeacher")
  cbtTestsCreated       CbtTest[]            @relation("CbtTestCreatedBy")
  studentsCreated       Student[]            @relation("StudentCreatedBy")
  attendanceScans       AttendanceRecord[]   @relation("ScannedBy")
  approvedLedgerEntries WalletLedgerEntry[]  @relation("ApprovedBy")
  passwordResetTokens   PasswordResetToken[]

  feePaymentsRecorded    FeePayment[]            @relation("FeePaymentRecordedBy")
  inventoryTxRecorded    InventoryTransaction[]  @relation("InventoryRecordedBy")
  expensesRecorded       ExpenseEntry[]          @relation("ExpenseRecordedBy")
  platformExpensesRecorded PlatformExpense[]      @relation("PlatformExpenseRecordedBy")
  notifications          Notification[]

  // ─── HR / staff ERP — see schema-changes-hr.prisma notes below ───────
  staffProfile           StaffProfile?
  payslipsReceived       Payslip[]      @relation("PayslipForUser")
  leaveRequestsReviewed  LeaveRequest[] @relation("LeaveReviewedBy")
  payrollRunsCreated     PayrollRun[]   @relation("PayrollRunCreatedBy")
  payrollRunsApproved    PayrollRun[]   @relation("PayrollRunApprovedBy")

  @@map("users")
}

// ─── Academic structure ─────────────────────────────────────────────────

model Class {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  name             String
  createdByStaffId String
  createdBy        User     @relation("ClassCreatedBy", fields: [createdByStaffId], references: [id])
  classTeacherId   String?
  classTeacher     User?    @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  createdAt        DateTime @default(now())

  students      Student[]
  cbtTests      CbtTest[]
  feeStructures FeeStructure[]
  lessonNotes   LessonNote[]
  subjects      ClassSubject[]
  assessmentWeights AssessmentWeight[]
  
  @@map("classes")
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Self-service school onboarding request — a prospective School Admin
/// submits this before a School row exists. SUPER_ADMIN reviews and, on
/// approval, the service layer creates the actual School + first User
/// from these fields. No FK to School here on purpose: this row exists
/// precisely because no School exists yet.
model SchoolSignupRequest {
  id            String              @id @default(uuid())
  schoolName    String
  slug          String              @unique
  code          String
  countryCode   String              // ISO 3166-1 alpha-2 — carried through to the real School row on approval
  timezone      String
  currency      String              // ISO 4217 — carried through to the real School row on approval
  locale        String              @default("en") // ISO 639-1 — carried through to the real School row on approval, see locale.util.ts
  adminName     String
  adminEmail    String
  adminPassword String // hashed immediately on submit — never stored plaintext, see service
  phone         String?
  status        SignupRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  reviewedAt    DateTime?

  @@map("school_signup_requests")
}

enum StudentStatus {
  PENDING_ID // created offline, awaiting server-assigned sequential ID — see spec doc §9.1
  ACTIVE
  WITHDRAWN // removed from their class by a class teacher/admin; history (results, attendance) stays intact
}

model Student {
  id                 String        @id @default(uuid())
  schoolId           String
  school             School        @relation(fields: [schoolId], references: [id])
  classId            String
  class              Class         @relation(fields: [classId], references: [id])
  studentId          String?       @unique // e.g. "GRW/2026/0001" — assigned server-side at sync, never on-device
  clientReferenceId  String?       @unique // client-generated UUID, set at creation time on-device — prevents duplicate rows if an offline-queued registration is retried after a partial success
  status             StudentStatus @default(PENDING_ID)
  firstName          String
  lastName           String
  photoUrl           String?
  admissionYear      Int
  createdByStaffId   String
  createdBy          User          @relation("StudentCreatedBy", fields: [createdByStaffId], references: [id])
  createdAt          DateTime      @default(now())

  results           ResultEntry[]
  idCards           IdCard[]
  attendanceRecords AttendanceRecord[]
  pins              Pin[]
  cbtAttempts       CbtAttempt[]
  feeInvoices       FeeInvoice[]
  assessmentScores AssessmentScore[]

  @@index([schoolId, admissionYear, status]) // serves the sequence-count query in createAndAssignId
  @@map("students")
}

model Term {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  name             String // e.g. "2025/2026 — Term 1"
  academicSession  String // e.g. "2025/2026" — groups terms 1-3 for session-level analysis
  termNumber       Int // not fixed its global
  startDate        DateTime
  endDate          DateTime

  results        ResultEntry[]
  pins           Pin[]
  calendarEvents AcademicCalendarEvent[]
  cbtTests       CbtTest[]
  feeStructures  FeeStructure[]
  feeInvoices    FeeInvoice[]
  lessonNotes    LessonNote[]
  assessmentScores AssessmentScore[]
  assessmentWeights AssessmentWeight[]

  @@unique([schoolId, academicSession, termNumber])
  @@index([schoolId, academicSession])
  @@map("terms")
}

model Subject {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  name     String

  classes ClassSubject[]

  @@unique([schoolId, name]) // catalog entries are unique per school — no duplicate "Mathematics"
  @@map("subjects")
}

/// Join table: which subjects a given class actually teaches. The
/// Subject catalog is school-wide (one "Mathematics" entry), but not
/// every class teaches every subject — SS3 Science students don't take
/// Fine Art, JSS1 doesn't take Further Mathematics, etc.
model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model ResultEntry {
  id             String   @id @default(uuid())
  schoolId       String
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  termId         String
  term           Term     @relation(fields: [termId], references: [id])
  subjectScores  Json // { "Mathematics": 78, "English": 82, ... }
  teacherComment String?
  classTeacherId String // NOTE: intentionally a plain string, not a User FK — see below
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Performance trend is computed at render time from prior ResultEntry
  // rows for the same student — deliberately not stored, so a later
  // correction to an old term's score doesn't leave a stale trend cached
  // anywhere. See spec doc §10.2.

  @@unique([schoolId, studentId, termId]) // one result per student per term; enables a real upsert
  @@map("result_entries")
}

// ─── Report cards ────────────────────────────────────────────────────────

model ReportTemplate {
  id                   String @id @default(uuid())
  schoolId             String @unique
  school               School @relation(fields: [schoolId], references: [id])
  schoolLogoUrl        String // pulled from School.logoUrl — never an Elorge asset, see spec doc §10.1
  headerFooterInfo     Json // pulled from School.info
  verificationQrPrefix String @default("https://elorgeschools.com/verify") // renders small, alongside the school's own branding

  @@map("report_templates")
}

// ─── Student PIN access ─────────────────────────────────────────────────

enum PinStatus {
  ACTIVE
  INVALIDATED // set immediately when a new term's PIN is generated — no grace period, see spec doc §6
}

model Pin {
  id          String    @id @default(uuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  pinHash     String // never store plaintext
  status      PinStatus @default(ACTIVE)
  generatedAt DateTime  @default(now())

  @@unique([schoolId, studentId, termId])
  @@index([schoolId, studentId, status]) // serves lookupResult's (schoolId, studentId, ACTIVE) query
  @@map("pins")
}

/// Rate limiting for the public, unauthenticated /results/lookup endpoint
/// (spec doc §6). Keyed on (schoolId, admissionId) as raw strings rather
/// than a Student FK, since a guessed admission ID may not correspond to
/// any real student and still needs to be throttled.
model PinLookupAttempt {
  id             String    @id @default(uuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id])
  admissionId    String // as typed by the client — matches Student.studentId when valid
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? // null = not locked
  lastAttemptAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([schoolId, admissionId])
  @@map("pin_lookup_attempts")
}

/// Single-use, expiring, hashed password-reset tokens. Backs the
/// self-service reset flow (forgot-password / reset-password endpoints).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // never store the raw token, only its hash
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── ID cards & attendance ──────────────────────────────────────────────

model IdCard {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  qrCode    String   @unique // encodes school_id + student_id; scanned for attendance
  issuedAt  DateTime @default(now())

  // Digital card generation is free/bundled — see spec doc §9.2. If
  // physical card fulfillment ships later, model it as a separate
  // PrintOrder entity with its own pricing, not a field here.

  @@map("id_cards")
}

model AttendanceRecord {
  id                String   @id @default(uuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  scannedByStaffId  String
  scannedBy         User     @relation("ScannedBy", fields: [scannedByStaffId], references: [id])
  source            String   @default("qr")
  occurredAt        DateTime // when the scan actually happened on-device — trusted within a clamp, see AttendanceService
  syncedAt          DateTime @default(now()) // when this record reached the server — kept separate from occurredAt so a late sync never looks like a late arrival
  clientReferenceId String   @unique // dedupes retried offline-queued scans, same pattern as Student.clientReferenceId

  @@index([schoolId, studentId])
  @@map("attendance_records")
}

// ─── Wallet & billing ───────────────────────────────────────────────────

enum LedgerType {
  CREDIT
  DEBIT
}

enum LedgerSource {
  GATEWAY
  MANUAL_TRANSFER
  DVA
  PROMO // includes the one-time ₦100,000 welcome bonus — see spec doc §7.5
  SYSTEM // internal debits (e.g. PIN generation) that aren't funding-sourced
  REFUND // reversal of a debit whose downstream work failed
  ADMIN_CREDIT // manual credit issued directly by a SUPER_ADMIN/FINANCE_OPS, outside the payment/transfer flow (goodwill, correction, etc.)
}

enum LedgerStatus {
  PENDING // manual transfer claim awaiting Finance/Ops review
  CONFIRMED
  REJECTED
}

/// Append-only. Never update or delete a row here, and never derive the
/// wallet balance from anywhere other than
/// SUM(confirmed credits) - SUM(confirmed debits) for a given schoolId.
/// See spec doc §7.4.
model WalletLedgerEntry {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  type           LedgerType
  amountKobo     Int // minor unit of `currency` below, never a float major-unit value
  currency       String       // ISO 4217 — copied from School.currency at creation time. Self-describing on purpose: lets platform-finance aggregate revenue per currency via groupBy without a join, and stays correct even if a school's currency were ever changed later.
  source         LedgerSource
  status         LedgerStatus @default(PENDING)
  reference      String       @unique // gateway tx ref, ELG-{school_id}-XXXX for transfers, welcome-bonus-{school_id}, or refund-{idempotencyKey}
  approvedById   String?
  approvedBy     User?        @relation("ApprovedBy", fields: [approvedById], references: [id])
  idempotencyKey String?      @unique // required on debits tied to a PIN generation request

  createdAt DateTime @default(now())

  @@index([schoolId, type, status]) // serves getBalanceKobo's two aggregate queries
  @@index([currency, type, status, createdAt]) // serves PlatformFinanceService.getOverview's per-currency revenue groupBy
  @@map("wallet_ledger")
}

enum CalendarEventType {
  TERM_START
  TERM_END
  MIDTERM_BREAK
  EXAM_PERIOD
  RESUMPTION
  PTA_MEETING
  HOLIDAY
  CUSTOM
}

model AcademicCalendarEvent {
  id          String            @id @default(uuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id])
  termId      String?
  term        Term?             @relation(fields: [termId], references: [id])
  type        CalendarEventType
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  createdAt   DateTime          @default(now())

  @@index([schoolId, termId])
  @@map("academic_calendar_events")
}

enum CbtTestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum CbtAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model CbtTest {
  id                 String        @id @default(uuid())
  schoolId           String
  school             School        @relation(fields: [schoolId], references: [id])
  termId             String
  term               Term          @relation(fields: [termId], references: [id])
  classId            String
  class              Class         @relation(fields: [classId], references: [id])
  subject            String // matches the subject key used in ResultEntry.subjectScores
  title              String
  durationMinutes    Int
  objectiveMaxScore  Int // sum of all question points — computed on publish, cached here for quick display
  theoryMaxScore     Int @default(0) // 0 = objectives-only test, no theory portion
  accessCode         String? @unique // generated at publish — student self-service uses this + Admission ID, spoken aloud on test day, NOT the parent's result PIN
  scheduledDate      DateTime // the calendar day this test is meant to run — access code only works on this day
  accessWindowMinutes Int @default(60) // how long AFTER scheduledDate's start the code stays valid — covers late starters, not an open-ended window
  status             CbtTestStatus @default(DRAFT)
  countsTowardReport Boolean @default(true) // false = practice/mock test, score never syncs into ResultEntry
  componentName      String  @default("Test") // ties into AssessmentWeight below — see Part 6
  createdByStaffId   String
  createdBy          User          @relation("CbtTestCreatedBy", fields: [createdByStaffId], references: [id])
  createdAt          DateTime      @default(now())

  questions CbtQuestion[]
  attempts  CbtAttempt[]

  @@map("cbt_tests")
}

enum CbtQuestionType {
  OBJECTIVE
  CODE
}

model CbtQuestion {
  id                 String          @id @default(uuid())
  testId             String
  test               CbtTest         @relation(fields: [testId], references: [id])
  type               CbtQuestionType @default(OBJECTIVE)
  questionText       String
  options            Json? // string[] — OBJECTIVE only
  correctOptionIndex Int? // OBJECTIVE only
  starterHtml        String? // CODE only
  starterCss         String? // CODE only
  starterJs          String? // CODE only
  testAssertions     Json? // CODE only — array of { description: string; assertion: string }, assertion is JS run inside the sandboxed iframe
  points             Int             @default(1)
  order              Int

  @@map("cbt_questions")
}

model CbtAttempt {
  id             String            @id @default(uuid())
  testId         String
  test           CbtTest           @relation(fields: [testId], references: [id])
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id])
  answers        Json              @default("{}") // { [questionId]: selectedOptionIndex }
  objectiveScore Int?
  theoryScore    Int?
  status         CbtAttemptStatus  @default(IN_PROGRESS)
  createdAt      DateTime          @default(now()) // when the attempt row was created (at publish)
  beginAt        DateTime? // when the student actually started — set on first getAttemptForStudent call, drives the countdown deadline
  submittedAt    DateTime?
  gradedAt       DateTime?

  @@unique([testId, studentId])
  @@map("cbt_attempts")
}

// ─── Fees ────────────────────────────────────────────────────────────────

enum FeeInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model FeeStructure {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  termId    String
  term      Term     @relation(fields: [termId], references: [id])
  classId   String?  // null = applies to every class this term
  class     Class?   @relation(fields: [classId], references: [id])
  name      String   // e.g. "Tuition", "Books", "Boarding"
  amountKobo Int
  createdAt DateTime @default(now())

  @@map("fee_structures")
}

model FeeInvoice {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id])
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  termId       String
  term         Term             @relation(fields: [termId], references: [id])
  totalKobo    Int
  paidKobo     Int              @default(0)
  status       FeeInvoiceStatus @default(UNPAID)
  createdAt    DateTime         @default(now())

  payments FeePayment[]

  @@unique([schoolId, studentId, termId])
  @@map("fee_invoices")
}

enum FeePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
}

model FeePayment {
  id          String           @id @default(uuid())
  schoolId    String
  school      School           @relation(fields: [schoolId], references: [id])
  invoiceId   String
  invoice     FeeInvoice       @relation(fields: [invoiceId], references: [id])
  amountKobo  Int
  method      FeePaymentMethod
  reference   String           @unique
  recordedById String
  recordedBy  User             @relation("FeePaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt   DateTime         @default(now())

  @@map("fee_payments")
}

// ─── Inventory ──────────────────────────────────────────────────────────

model InventoryItem {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  name         String
  category     String?  // e.g. "Furniture", "IT Equipment", "Consumables"
  unit         String   @default("pcs")
  quantityOnHand Int    @default(0)
  reorderLevel Int      @default(0) // below this, flag as low-stock
  unitCostKobo Int      @default(0)
  createdAt    DateTime @default(now())

  transactions InventoryTransaction[]

  @@map("inventory_items")
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
}

model InventoryTransaction {
  id           String                    @id @default(uuid())
  schoolId     String
  school       School                    @relation(fields: [schoolId], references: [id])
  itemId       String
  item         InventoryItem             @relation(fields: [itemId], references: [id])
  type         InventoryTransactionType
  quantity     Int
  note         String?
  recordedById String
  recordedBy   User                      @relation("InventoryRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime                  @default(now())

  @@map("inventory_transactions")
}

// ─── Accounting (lean: expenses + a derived income/expenditure report) ───

model ExpenseEntry {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  category     String   // e.g. "Salaries", "Utilities", "Maintenance", "Inventory Purchase"
  description  String
  amountKobo   Int
  incurredAt   DateTime
  recordedById String
  recordedBy   User     @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("expense_entries")
}

enum LessonNoteStatus {
  DRAFT
  PUBLISHED
}

model LessonNote {
  id                    String           @id @default(uuid())
  schoolId              String
  school                School           @relation(fields: [schoolId], references: [id])
  classId               String
  class                 Class            @relation(fields: [classId], references: [id])
  termId                String
  term                  Term             @relation(fields: [termId], references: [id])
  subject               String
  topic                 String
  durationMinutes       Int?
  objectives            String // "By the end of this lesson, students should be able to..." — one per line
  instructionalMaterials String?
  previousKnowledge     String?
  presentation          String // the main teaching content — split into projector slides by a "---" line, see PresenterView
  evaluation            String?
  assignment            String?
  summary               String?
  status                LessonNoteStatus @default(DRAFT)
  createdByStaffId      String
  createdBy             User             @relation("LessonNoteCreatedBy", fields: [createdByStaffId], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  materials             LessonMaterial[]

  @@index([schoolId, classId, termId, status])
  @@map("lesson_notes")
}

enum LessonMaterialType {
  IMAGE
  PDF_PAGE
  SLIDE
}

model LessonMaterial {
  id               String             @id @default(uuid())
  lessonNoteId     String
  lessonNote       LessonNote         @relation(fields: [lessonNoteId], references: [id], onDelete: Cascade)
  type             LessonMaterialType
  url              String
  order            Int
  insertAfter      String             // "start" | "objectives" | "previousKnowledge" | "evaluation" | "assignment" | "summary" | "end"
  originalFilename String?
  createdAt        DateTime           @default(now())

  @@index([lessonNoteId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model PlatformExpense {
  id           String   @id @default(uuid())
  category     String   // e.g. "Salaries", "Hosting", "Software Licenses", "Marketing"
  description  String
  amountKobo   Int
  currency     String   @default("NGN") // platform's own operating currency for this line item — usually your home currency (override PLATFORM_DEFAULT_CURRENCY via env), but flexible if a vendor is paid in USD, etc.
  incurredAt   DateTime
  recordedById String
  recordedBy   User     @relation("PlatformExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([currency, incurredAt]) // serves PlatformFinanceService.getOverview's per-currency expense groupBy
  @@map("platform_expenses")
}

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?  // null for platform-level actions (suspend, manual credit) not scoped to normal tenant access
  actorId    String?  // null if the action was system-triggered, not a specific user
  action     String   // e.g. "result.updated", "fee_payment.recorded", "school.suspended"
  entityType String   // e.g. "ResultEntry", "FeeInvoice", "School"
  entityId   String
  metadata   Json?    // before/after values or other context, kept loose on purpose
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model AssessmentWeight {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  termId        String?  // null = applies to every term unless overridden by a term-specific set — same pattern as `subject`
  term          Term?    @relation(fields: [termId], references: [id])
  subject       String?  // null = applies to every subject in this class unless overridden by a subject-specific set
  componentName String   // e.g. "Test", "Exam", "CA1" — free text, not a fixed enum, since schools vary
  weightPercent Int
  createdAt     DateTime @default(now())

  @@map("assessment_weights")
}

model AssessmentScore {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  termId        String
  term          Term     @relation(fields: [termId], references: [id])
  subject       String
  componentName String
  score         Int      // 0-100
  source        String   // "CBT" | "MANUAL"
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([schoolId, studentId, termId, subject, componentName])
  @@map("assessment_scores")
}

model SubjectCareerField {
  id        String   @id @default(uuid())
  schoolId  String?  // null = global default, visible to every school
  school    School?  @relation(fields: [schoolId], references: [id])
  subject   String
  field     String
  createdAt DateTime @default(now())

  @@unique([schoolId, subject, field])
  @@index([subject])
  @@map("subject_career_fields")
}

// ─── HR / staff ERP ─────────────────────────────────────────────────────
// A User row (role SCHOOL_ADMIN or STAFF) is the login/identity; a
// StaffProfile is the HR record hung off it 1:1 — kept separate rather
// than bloating User because most of this (bank details, salary,
// next-of-kin) is HR-only data that non-HR code paths never touch.
// SUPER_ADMIN/FINANCE_OPS users never get a StaffProfile — they're
// Elorge platform staff, not a school's employee.

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  NYSC // Nigeria's National Youth Service Corps posting — common enough in this market to name explicitly rather than force into CONTRACT
  VOLUNTEER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model StaffProfile {
  id       String @id @default(uuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])

  staffId          String           @unique // e.g. "GRW/STAFF/0001" — same sequential pattern as Student.studentId, see StaffService.createAndAssignStaffId
  department       String?
  designation      String? // job title, e.g. "Mathematics Teacher", "Bursar"
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  dateOfEmployment DateTime?
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  address          String?
  nextOfKinName    String?
  nextOfKinPhone   String?
  nextOfKinRelationship String?
  maritalStatus    String?
  stateOfOrigin    String?
  qualifications   String? // free text: degrees / certifications, e.g. "B.Ed Mathematics, TRCN registered"
  bankName         String?
  bankAccountName  String?
  bankAccountNumber String?
  photoUrl         String?

  // Current recurring salary structure. Minor unit of School.currency,
  // same convention as every other *Kobo field. Payroll snapshots these
  // onto each Payslip.breakdown at generation time — editing them here
  // only affects payroll runs generated AFTER the edit, never past
  // payslips (spec parity with FeeStructure vs FeeInvoice).
  baseSalaryKobo Int   @default(0)
  allowances     Json? // [{ name: string, amountKobo: number }]
  deductions     Json? // [{ name: string, amountKobo: number }] — recurring deductions other than one-off payroll adjustments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idCards           StaffIdCard[]
  idCardRequests    StaffIdCardRequest[]
  payslips          Payslip[]
  leaveRequests     LeaveRequest[]
  leaveBalances     StaffLeaveBalance[]
  attendanceRecords StaffAttendanceRecord[]

  @@index([schoolId, employmentStatus])
  @@map("staff_profiles")
}

/// Deliberately a separate model from IdCard (students) rather than a
/// shared polymorphic table — the two have different renderers (see
/// StaffIdCardsService.renderIdCardPdf) and different lifecycle rules,
/// and a shared table would need a nullable studentId AND nullable
/// staffProfileId, which is worse than two small tables.
model StaffIdCard {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  qrCode         String       @unique // encodes school_id + staff_profile_id; scanned for staff attendance
  issuedAt       DateTime     @default(now())

  @@map("staff_id_cards")
}

enum IdCardRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A staff member's request for a (first or replacement) ID card. Approving
/// it issues a StaffIdCard (see StaffService.reviewIdCardRequest), which is
/// what the PDF renderer actually reads — the request row is just the
/// approval trail.
model StaffIdCardRequest {
  id             String                  @id @default(uuid())
  schoolId       String
  school         School                  @relation(fields: [schoolId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile            @relation(fields: [staffProfileId], references: [id])
  reason         String? // e.g. "First card", "Lost", "Damaged"
  status         IdCardRequestStatus     @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime                @default(now())

  @@index([schoolId, status])
  @@index([staffProfileId, status])
  @@map("staff_id_card_requests")
}

enum StaffAttendanceDirection {
  CLOCK_IN
  CLOCK_OUT
}

model StaffAttendanceRecord {
  id                String                   @id @default(uuid())
  schoolId          String
  school            School                   @relation(fields: [schoolId], references: [id])
  staffProfileId    String
  staffProfile      StaffProfile             @relation(fields: [staffProfileId], references: [id])
  direction         StaffAttendanceDirection @default(CLOCK_IN)
  source            String                   @default("qr") // "qr" | "manual"
  occurredAt        DateTime // on-device scan time, clamped the same way as student AttendanceRecord — see ATTENDANCE_MAX_BACKDATE_HOURS
  syncedAt          DateTime                 @default(now())
  clientReferenceId String                   @unique

  @@index([schoolId, staffProfileId, occurredAt])
  @@map("staff_attendance_records")
}

enum PayrollRunStatus {
  DRAFT // generated, editable/regeneratable, nothing paid yet
  APPROVED // locked in by a School Admin, ready for disbursement
  PAID // every payslip in the run has been marked paid
  CANCELLED
}

/// One PayrollRun = one pay period for one school. Generating a run
/// snapshots every ACTIVE staff member's current StaffProfile salary
/// structure into a Payslip row each — see PayrollService.generateRun.
model PayrollRun {
  id                  String           @id @default(uuid())
  schoolId            String
  school              School           @relation(fields: [schoolId], references: [id])
  periodLabel         String // e.g. "September 2026" — free text, school's own convention
  periodStart         DateTime
  periodEnd           DateTime
  status              PayrollRunStatus @default(DRAFT)
  totalGrossKobo      Int              @default(0)
  totalDeductionsKobo Int              @default(0)
  totalNetKobo        Int              @default(0)
  createdById         String
  createdBy           User             @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?            @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())

  payslips Payslip[]

  @@index([schoolId, status])
  @@map("payroll_runs")
}

enum PayslipStatus {
  PENDING
  PAID
}

model Payslip {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  payrollRunId   String
  payrollRun     PayrollRun   @relation(fields: [payrollRunId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  userId         String // denormalized from StaffProfile.userId so "my payslips" queries skip the join
  user           User         @relation("PayslipForUser", fields: [userId], references: [id])

  baseSalaryKobo Int
  allowancesKobo Int
  deductionsKobo Int
  grossKobo      Int
  netKobo        Int
  currency       String // copied from School.currency at generation time, same self-describing pattern as WalletLedgerEntry.currency
  breakdown      Json // snapshot: { allowances: [{name,amountKobo}], deductions: [{name,amountKobo}] } — frozen at generation, never re-derived from live StaffProfile

  status            PayslipStatus @default(PENDING)
  paidAt            DateTime?
  paymentReference  String? // manual bank transfer reference / receipt number recorded by the admin marking this paid
  expenseEntryId    String?       @unique // links to the ExpenseEntry (category "Salaries") written on payment, so payroll and accounting never double-count
  createdAt         DateTime      @default(now())

  @@unique([payrollRunId, staffProfileId])
  @@index([schoolId, userId])
  @@map("payslips")
}

model LeaveType {
  id                 String   @id @default(uuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  name               String // e.g. "Annual Leave", "Sick Leave", "Maternity/Paternity Leave"
  defaultDaysPerYear Int      @default(0)
  createdAt          DateTime @default(now())

  leaveRequests LeaveRequest[]
  balances      StaffLeaveBalance[]

  @@unique([schoolId, name])
  @@map("leave_types")
}

/// One row per staff/leaveType/year. Created lazily (from
/// LeaveType.defaultDaysPerYear) the first time it's needed rather than
/// batch-provisioned for every staff member up front, so adding a new
/// LeaveType never requires a backfill job.
model StaffLeaveBalance {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  year           Int
  daysAllotted   Int
  daysUsed       Int          @default(0)

  @@unique([staffProfileId, leaveTypeId, year])
  @@map("staff_leave_balances")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  daysCount      Int
  reason         String?
  status         LeaveStatus  @default(PENDING)
  reviewedById   String?
  reviewedBy     User?        @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime     @default(now())

  @@index([schoolId, status])
  @@index([staffProfileId, status])
  @@map("leave_requests")
}
// ───────────── Website live chat (Telegram-backed) ─────────────
enum ChatSender {
  VISITOR
  AGENT
  BOT
}

model ChatConversation {
  id             String        @id @default(uuid())
  token          String        @unique // secret held by the visitor's browser
  tag            String        @unique // short code agents see in Telegram, e.g. #a1b2c3
  name           String
  email          String
  phone          String
  countryCode    String
  locale         String        @default("en")
  pageUrl        String?
  waitingSince   DateTime? // set while a visitor is waiting for a human answer
  nudgeSentAt    DateTime?
  followUpSentAt DateTime?
  lastSeenAt     DateTime      @default(now())
  lastAgentAt    DateTime?
  createdAt      DateTime      @default(now())
  messages       ChatMessage[]

  @@index([waitingSince])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  seq            Int              @unique @default(autoincrement())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  text           String
  agentName      String?
  tgReplyId      Int?             @unique // Telegram message id of an agent reply (de-dupes webhook retries)
  createdAt      DateTime         @default(now())

  @@index([conversationId, seq])
  @@map("chat_messages")
}
